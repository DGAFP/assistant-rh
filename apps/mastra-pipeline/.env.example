# Albert API (DINUM) — French sovereign LLM service
# Get your key at https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1

# Scaleway fallback provider (already supported by Mastra/OpenAI-compatible APIs)
SCALEWAY_API_KEY=
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
# Optional fallback accepted by lib/albert.ts
SCW_GENERATIVE_APIs_ENDPOINT=https://api.scaleway.ai/v1

# PostgreSQL
SCW_POSTGRES_DSN=
SCALINGO_POSTGRESQL_URL=

# Prompt source strategy during dual-run compatibility period
# - db_first: use system_prompts table first (default)
# - mastra_only: skip DB prompt fetch, rely on Mastra/agent-managed prompts
PROMPT_SOURCE_MODE=db_first

# Optional DB pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Optional: make health check fail hard when DB/provider checks are unhealthy
HEALTHCHECK_STRICT=0
