# Mastra
ALBERT_API_KEY=your-albert-api-key
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
SCALEWAY_API_KEY=your-scaleway-api-key

# PostgreSQL
PGHOST=your-pg-host
PGPORT=5432
PGUSER=your-pg-user
PGPASSWORD=your-pg-password
PGDATABASE=your-pg-database

# === Required ===
SCALINGO_POSTGRESQL_URL=postgres://user:pass@host:port/db?sslmode=prefer
SCALINGO_TUNNEL_DSN=
APP_DB_TARGET=
APP_SCALEWAY_ENV=prod
# Canonical DSN mapping (no implicit cross-env fallback):
# - APP_DB_TARGET=scalingo -> SCALINGO_POSTGRESQL_URL
SCW_POSTGRES_DSN=postgresql://user:pass@host:port/assistant_rh?sslmode=require
APP_POSTGRES_DSN=
STREAMLIT_POSTGRES_DSN=

# === Scaleway (LLM + embeddings fallback) ===
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_REGION=fr-par
SCW_GENERATIVE_APIs_ENDPOINT=https://api.scaleway.ai/v1
SCW_BUCKET_BRONZE=assistant-rh-bronze
SCW_BUCKET_SILVER=assistant-rh-silver
SCW_BUCKET_GOLD=assistant-rh-gold
# Optional future use if you add a staging lane.
SCW_PREFIX_STAGING=staging
SCW_PREFIX_PROD=prod

# === OpenAI (RAGAS metrics) ===
OPENAI_API_KEY=


# === Private datasets (restricted evaluation artifacts) ===
# Used by admin/evaluation pages when restricted CSVs are not present locally.
HF_TOKEN=
ASSISTANT_RH_PRIVATE_DATASET_REPO=DGAFP/assistant-rh-private-data
ASSISTANT_RH_PRIVATE_DATASET_REVISION=
ASSISTANT_RH_PRIVATE_DATASET_CACHE_DIR=.cache/assistant-rh/private-datasets
ASSISTANT_RH_GOLDEN_BETA_SOURCE=auto
ASSISTANT_RH_GOLDEN_BETA_SUBDIR=golden_beta

# === Admin pages ===
ADMIN_PASSWORD=

# Encryption key for browser cookies (user_group). REQUIRED in staging/prod.
COOKIES_PASSWORD=
# Local dev only: allow explicit insecure fallback when COOKIES_PASSWORD is missing.
# NEVER enable this in staging/prod.
ALLOW_INSECURE_COOKIES_PASSWORD=false

# --- Notebooks / scripts defaults ---
PGSCHEMA=
PGSSLMODE=
SCALINGO_URL=

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_COLUMN=embedding_m3
EMBEDDING_COLUMN_JSON=embedding_m3
EMBEDDING_COLUMN_DB=embedding_m3
TOKENIZERS_PARALLELISM=True
OCR_LANG=fra
OCR_DPI=300

# Service Public (SP)
