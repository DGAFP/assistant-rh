{
  "uid": "assistant-rh-rag-evals",
  "title": "Assistant RH - Évaluations RAG",
  "id": null,
  "version": 1,
  "schemaVersion": 39,
  "editable": true,
  "tags": [
    "assistant-rh",
    "rag",
    "evals"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source de métriques",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environnement",
        "type": "custom",
        "query": "staging,prod",
        "current": {
          "text": "staging",
          "value": "staging",
          "selected": true
        },
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      },
      {
        "name": "goldset",
        "label": "Goldset",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "query_result(max by (goldset) (assistant_rh_rag_eval_run_info{env=~\"$env\"}))",
        "definition": "query_result(max by (goldset) (assistant_rh_rag_eval_run_info{env=~\"$env\"}))",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "regex": "/goldset=\"([^\"]+)\"/"
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "query_result(max by (run_id) (assistant_rh_rag_eval_run_info{env=~\"$env\",goldset=~\"$goldset\"}))",
        "definition": "query_result(max by (run_id) (assistant_rh_rag_eval_run_info{env=~\"$env\",goldset=~\"$goldset\"}))",
        "current": {},
        "refresh": 2,
        "sort": 4,
        "includeAll": false,
        "multi": false,
        "regex": "/run_id=\"([^\"]+)\"/"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## Évaluations RAG\nRésultats enregistrés · Sélectionnez un goldset puis un run. Le nombre de questions, le juge et le périmètre accompagnent les scores. Les **50 derniers runs par environnement** sont exposés ; les dates correspondent aux évaluations, pas aux collectes."
      }
    },
    {
      "id": 1,
      "title": "Runs disponibles",
      "description": "Fenêtre des 50 derniers runs enregistrés, tous goldsets. Zéro signifie aucune évaluation enregistrée ; Non disponible signifie métriques absentes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "assistant_rh_rag_eval_runs_exposed{env=~\"$env\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Non disponible",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Run sélectionné · $run",
      "description": "Statut d’exécution. Terminé ne signifie pas que la qualité est satisfaisante.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
