            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Démarré",
                  "color": "blue"
                },
                "1": {
                  "text": "Terminé",
                  "color": "blue"
                },
                "2": {
                  "text": "Échec technique",
                  "color": "red"
                },
                "3": {
                  "text": "Seuil qualité non atteint",
                  "color": "orange"
                },
                "4": {
                  "text": "Autre statut",
                  "color": "gray"
