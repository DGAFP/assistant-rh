            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Non demandée",
                  "color": "gray"
                },
                "1": {
                  "text": "Validée",
                  "color": "green"
                },
                "2": {
                  "text": "Seuil non atteint",
                  "color": "orange"
                },
                "3": {
                  "text": "Non comparable",
                  "color": "orange"
