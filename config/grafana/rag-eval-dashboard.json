    {
      "id": 12,
      "title": "Comparaison à la baseline",
      "description": "Verdict stocké par le runner. Aucune comparaison automatique entre deux runs du dashboard.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "assistant_rh_rag_eval_baseline_status{env=~\"$env\",goldset=~\"$goldset\",run_id=\"$run\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
