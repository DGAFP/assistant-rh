      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH chunk_events AS (\n  SELECT\n    e.created_at,\n    e.turn_id,\n    e.trace_id,\n    e.stage,\n    e.attempt_name,\n    e.status,\n    item AS chunk\n  FROM rag_trace_events e\n  CROSS JOIN LATERAL jsonb_array_elements(\n    CASE\n      WHEN e.output_ref ? 'retrieved_chunks' THEN e.output_ref->'retrieved_chunks'\n      WHEN e.output_ref ? 'aggregated_sections' THEN e.output_ref->'aggregated_sections'\n      WHEN e.output_ref ? 'context_items' THEN e.output_ref->'context_items'\n      ELSE '[]'::jsonb\n    END\n  ) AS item\n  WHERE ('$turn_id' = '' OR e.turn_id = '$turn_id')\n    AND ('$trace_id' = '' OR e.trace_id = '$trace_id')\n    AND ('$stage' = '.*' OR e.stage = '$stage')\n    AND ('$status' = '.*' OR e.status = '$status')\n    AND ('$env' = '.*' OR e.env = '$env')\n)\nSELECT\n  created_at,\n  turn_id,\n  trace_id,\n  stage,\n  attempt_name,\n  status,\n  COALESCE(chunk->>'chunk_id', chunk->>'section_id', '') AS chunk_id,\n  COALESCE(chunk->>'table', chunk->>'publisher', '') AS source_table,\n  NULLIF(chunk->>'score', '')::double precision AS score,\n  chunk->>'section_id' AS section_id,\n  chunk->>'heading' AS heading,\n  chunk->>'preview' AS preview\nFROM chunk_events\nWHERE ('$source_table' = '' OR COALESCE(chunk->>'table', chunk->>'publisher', '') ILIKE '%' || '$source_table' || '%')\nORDER BY created_at DESC, stage ASC, score DESC NULLS LAST\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Chunks by stage (bounded previews)",
      "type": "table"
    },
