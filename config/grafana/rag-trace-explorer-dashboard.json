  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "$trace_datasource"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace in this dashboard",
                    "url": "/d/assistant-rh-rag-trace-explorer/assistant-rh-rag-trace-explorer?from=${__from}&to=${__to}&var-trace_datasource=$trace_datasource&var-metrics_datasource=$metrics_datasource&var-env=$env&var-turn_id=$turn_id&var-trace_id_filter=$trace_id_filter&var-trace_id=${__data.fields.traceID}&var-stage=$stage&var-status=$status"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "limit": 20,
          "query": "{ resource.service.name = \"assistant-rh\" && span.rag.turn_id =~ \"$turn_id\" && span.rag.trace_id =~ \"$trace_id_filter\" && span.rag.stage =~ \"$stage\" && span.rag.status =~ \"$status\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "serviceStats": true,
              "spanSet": true,
              "spanSets": true,
              "nested": true
            },
            "indexByName": {
              "durationMs": 4,
              "rootServiceName": 1,
              "rootTraceName": 2,
              "startTimeUnixNano": 3,
              "traceID": 0
            },
            "renameByName": {
              "durationMs": "Duration (ms)",
              "rootServiceName": "Service",
              "rootTraceName": "Root span",
              "startTimeUnixNano": "Start",
              "traceID": "Trace ID"
            }
          }
        }
      ],
      "title": "Recent RAG traces",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "$trace_datasource"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "query": "$trace_id",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Selected trace waterfall",
      "type": "traces"
    },
    {
      "id": 8,
      "title": "Chunks et contexte par étape",
      "description": "Une ligne par étape et tentative, pour la trace sélectionnée. Les extraits sont limités à 500 caractères et le budget par étape est borné : Affichés / Total indique les éléments omis. Les scores de chunk et de section ne sont pas directement comparables. Retenu / Écarté décrit le résultat effectif du sélecteur ; son motif est global. Les anciennes traces ne contiennent pas les extraits : consulter Détails structurés. Le contexte final peut être une section ou un document entier.",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "$trace_datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"assistant-rh\" && span.rag.trace_id = \"$trace_id\" && span.rag.turn_id =~ \"$turn_id\" && span.rag.stage =~ \"$stage\" && span.rag.status =~ \"$status\" } | select(span.rag.stage, span.rag.attempt_name, span.rag.status, span.rag.evidence, span.rag.evidence.total, span.rag.evidence.shown, span.rag.evidence.truncated, span.rag.selection.reason, span.output.value)",
          "tableType": "spans",
          "limit": 1,
          "spss": 100
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "enablePagination": false
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Étape"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 155
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tentative"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Chunks / sections — extraits et scores"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 680
              },
              {
                "id": "noValue",
                "value": "Extraits non disponibles pour cette trace"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Motif global du sélecteur"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 250
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Affichés"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 75
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Affichage limité"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Détails structurés"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "json-view"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "rag.stage",
                "rag.attempt_name",
                "rag.status",
                "rag.evidence",
                "rag.selection.reason",
                "rag.evidence.shown",
                "rag.evidence.total",
                "rag.evidence.truncated",
                "output.value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "rag.stage": 0,
              "rag.attempt_name": 1,
              "rag.status": 2,
              "rag.evidence": 3,
              "rag.selection.reason": 4,
              "rag.evidence.shown": 5,
              "rag.evidence.total": 6,
              "rag.evidence.truncated": 7,
              "output.value": 8
            },
            "renameByName": {
              "rag.stage": "Étape",
              "rag.attempt_name": "Tentative",
              "rag.status": "Statut",
              "rag.evidence": "Chunks / sections — extraits et scores",
              "rag.selection.reason": "Motif global du sélecteur",
              "rag.evidence.shown": "Affichés",
              "rag.evidence.total": "Total",
              "rag.evidence.truncated": "Affichage limité",
              "output.value": "Détails structurés"
            }
          }
        }
      ]
    },
    {
