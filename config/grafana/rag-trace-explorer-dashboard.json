      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, turn_id, trace_id, stage, attempt_name, status, error_type, error_message, metrics\nFROM rag_trace_events\nWHERE ('$turn_id' = '' OR turn_id = '$turn_id')\n  AND ('$trace_id' = '' OR trace_id = '$trace_id')\n  AND ('$stage' = '.*' OR stage = '$stage')\n  AND ('$status' = '.*' OR status = '$status')\n  AND ('$env' = '.*' OR env = '$env')\n  AND (status IN ('failed', 'error') OR error_type <> '' OR metrics ? 'reranker_status')\nORDER BY created_at DESC, event_index ASC\nLIMIT 200;",
          "refId": "A"
        }
      ],
      "title": "Errors, fallbacks, and provider status",
      "type": "table"
