FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# LibreOffice headless: conversion .doc/.docx/.xls/.xlsx -> PDF avant OCR
# (flux bureautique récurrent des sources ministérielles, décision 2026-07-04).
# Pas de sentence-transformers: les embeddings passent par les API Albert et
# Scaleway — c'est ce qui garde cette image légère par rapport à embeddings-job.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl ca-certificates unzip \
        libreoffice-writer libreoffice-calc libreoffice-impress fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip" \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip

COPY README.md ./
COPY config ./config
COPY src ./src
COPY packages/shared-config ./packages/shared-config
COPY packages/data-engineering ./packages/data-engineering
COPY apps/data-ingestion-cli ./apps/data-ingestion-cli

RUN pip install --no-cache-dir \
    ./packages/shared-config \
    ./packages/data-engineering \
    ./apps/data-ingestion-cli

CMD ["data-ingestion", "mi", "medallion", "--help"]
