FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY packages/rag-pipeline ./packages/rag-pipeline

RUN pip install --no-cache-dir \
    "streamlit>=1.55.0" \
    "streamlit-cookies-manager>=0.2.0" \
    "pandas>=2.3.3,<3" \
    "numpy>=2.4.3,<3" \
    "openpyxl>=3.1.5" \
    "python-dotenv>=1.2.2" \
    "filelock>=3.25.2" \
    "psycopg[binary]>=3.3.3" \
    "sqlalchemy>=2.0.48" \
    "openai>=2.28.0" \
    "requests>=2.32.5" \
    "plotly>=6.6.0" \
    "beautifulsoup4>=4.14.3"

RUN pip install --no-cache-dir ./packages/rag-pipeline

COPY README.md ./
COPY src ./src
COPY apps/streamlit-ui ./apps/streamlit-ui

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -fsS http://127.0.0.1:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "apps/streamlit-ui/Home.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
