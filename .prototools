# Proto tool version configuration
# https://moonrepo.dev/docs/proto

# Python version (read by unstable_python toolchain)
python = "3.12.13"

# uv version for package management (pinned for reproducibility)
uv = "0.11.18"

# Node.js and pnpm for JavaScript dependency security scans
node = "24.16.0"
pnpm = "10.34.1"

[settings]
# Auto-install missing tool versions
auto-install = true
