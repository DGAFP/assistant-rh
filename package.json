{
  "name": "assistant-rh-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "mastra:dev": "pnpm --filter @assistant-rh/mastra-pipeline dev",
    "mastra:build": "pnpm --filter @assistant-rh/mastra-pipeline build",
    "conformance:help": "uv run python scripts/run_mastra_conformance.py --help",
    "lint:ts": "biome check apps/mastra-pipeline/src apps/mastra-pipeline/scripts",
    "security:scan:js": "cve-lite . --fail-on high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "cve-lite-cli": "1.25.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
