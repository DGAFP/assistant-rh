FROM grafana/alloy:v1.11.0 AS alloy

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV RAG_HEALTH_EXPORTER_HOST=0.0.0.0
ENV RAG_HEALTH_EXPORTER_PORT=9108
ENV DB_HEALTH_POLL_INTERVAL_SECONDS=300

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=alloy /bin/alloy /usr/local/bin/alloy

COPY README.md ./
COPY config/grafana-alloy ./config/grafana-alloy
COPY scripts/run_rag_health_exporter.sh ./scripts/run_rag_health_exporter.sh
COPY packages/shared-config ./packages/shared-config
COPY packages/data-engineering ./packages/data-engineering
COPY apps/data-ingestion-cli ./apps/data-ingestion-cli

RUN pip install --no-cache-dir \
    ./packages/shared-config \
    ./packages/data-engineering \
    ./apps/data-ingestion-cli

EXPOSE 9108

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:${RAG_HEALTH_EXPORTER_PORT}/healthz >/dev/null || exit 1

CMD ["sh", "scripts/run_rag_health_exporter.sh"]
